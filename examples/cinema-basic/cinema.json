  "prompt": "@prompt.md",
  "lorebookBudget": 500,
  "images": {
    "도서관_밤": {"src": "img/library-night.png", "desc": "비 오는 밤의 열람실"},
    "린_미소": {"src": "img/rin-smile.png", "desc": "린, 옅은 미소"},
    "린_놀람": {"src": "img/rin-surprised.png", "desc": "린, 놀란 얼굴"}
  },
  "startSessions": [
    {
      "sessionTitle": "폐관 30분 전",
      "initDesc": "# {user}의 신분\n매주 목요일 같은 자리에 앉는 단골 이용자.\n# 현재 상황\n폭우로 버스가 끊겼고, 열람실에는 {user}와 린 둘만 남았다.",
      "defaults": {"배경": "도서관_밤", "상태": "열람실 · 오후 9시 30분 · 폭우"},
